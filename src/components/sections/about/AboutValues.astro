---
import Button from '../../ui/Button.astro';
---

<section class="section_about-values">
        <div class="section-gap">
          <div class="container-main">
            <div class="about-values-panel">
              <div class="about-values-content">
                <div class="section-header-title-block">
                  <div class="section-eyebrow">
                    <div class="section-eyebrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10 0C10.75 6.25 13.75 9.25 20 10C13.75 10.75 10.75 13.75 10 20C9.25 13.75 6.25 10.75 0 10C6.25 9.25 9.25 6.25 10 0Z" fill="currentColor"></path>
                      </svg></div>
                    <div class="section-eyebrow-label">Our Values</div>
                  </div>
                  <h2 class="heading-style-2 section-header-heading">What We Hold <span class="heading-accent">Ourselves To<div class="heading-accent-line is-blue is-pos-values w-embed"><svg width="100%" height="100%" viewBox="0 0 270 18" preserveAspectRatio="none" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                          <path d="M4 9C70 5 160 4 266 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                          <path d="M44 15C120 11 200 10 246 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                        </svg></div></span></h2>
                  <Button href="/contact-v1" variant="dark">Start a Conversation</Button>
                </div>
              </div>
              <div class="about-values-cards">
                <div class="about-values-card is-candour"><img src="/images/about-value-candour.webp" loading="lazy" sizes="100vw" srcset="/images/about-value-candour-p-500.webp 500w, /images/about-value-candour.webp 780w" alt="" class="about-values-card-image" />
                  <div class="about-values-card-text">
                    <h3 class="about-values-card-title">Candour</h3>
                    <p class="about-values-card-summary">We say what we see — even when it is uncomfortable, and especially when it matters.</p>
                  </div>
                </div>
                <div class="about-values-card is-rigor"><img src="/images/about-value-rigor.webp" loading="lazy" sizes="100vw" srcset="/images/about-value-rigor-p-500.webp 500w, /images/about-value-rigor.webp 780w" alt="" class="about-values-card-image" />
                  <div class="about-values-card-text">
                    <h3 class="about-values-card-title">Rigor</h3>
                    <p class="about-values-card-summary">Every recommendation is backed by evidence you can inspect and challenge.</p>
                  </div>
                </div>
                <div class="about-values-card is-ownership"><img src="/images/about-value-ownership.webp" loading="lazy" sizes="100vw" srcset="/images/about-value-ownership-p-500.webp 500w, /images/about-value-ownership.webp 780w" alt="" class="about-values-card-image" />
                  <div class="about-values-card-text">
                    <h3 class="about-values-card-title">Ownership</h3>
                    <p class="about-values-card-summary">We measure ourselves by your results, not by the volume of our deliverables.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
