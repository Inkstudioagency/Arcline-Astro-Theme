---
import Button from '../../ui/Button.astro';
---

<section class="section_about-approach">
        <div class="section-gap">
          <div class="container-main">
            <div class="about-approach-wrapper">
              <div class="section-header">
                <div class="section-header-title-block">
                  <div class="section-eyebrow">
                    <div class="section-eyebrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10 0C10.75 6.25 13.75 9.25 20 10C13.75 10.75 10.75 13.75 10 20C9.25 13.75 6.25 10.75 0 10C6.25 9.25 9.25 6.25 10 0Z" fill="currentColor"></path>
                      </svg></div>
                    <div class="section-eyebrow-label">Our Approach</div>
                  </div>
                  <h2 class="heading-style-2 section-header-heading">Diagnose.<br />Decide. Deliver.</h2>
                  <div class="section-header-doodle is-pos-approach w-embed"><svg width="100%" height="100%" viewBox="0 0 45 50" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                      <path d="M2 27C3.3557 18.4591 6.90298 10.3881 9 2" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                      <path d="M17.5 32C25.9926 27.1537 34.4984 22.3305 43 17.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                      <path d="M19.8228 47.1832C26.5813 47.234 33.3158 47.9922 40.048 47.9922" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                    </svg></div>
                </div>
                <div class="section-header-summary-block">
                  <p class="text-size-regular">A simple model we use on every engagement, whatever its size.</p>
                </div>
              </div>
              <div class="about-approach-grid">
                <div data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;ce985c98-4700-76b8-8900-aab539529107&quot;],[]]]" class="about-approach-card is-diagnose">
                  <div aria-hidden="true" class="about-approach-visual">
                    <div class="about-approach-stage"><img src="/images/about-diagnose-base.webp" loading="lazy" alt="Illustration of a network diagram on a blue gradient background with nodes labeled Problem is clear, Operators, Leadership, Customers, and Data connected by lines." class="about-approach-layer" />
                      <div data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;d8eb2ca1-1801-2a2d-c8f6-def341d3213e&quot;],[]]]" class="about-approach-route-mask"><img src="/images/about-diagnose-route.svg" loading="lazy" data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;80ce821a-578c-0b48-380b-52445eac74cf&quot;],[]]]" alt="A smooth, curving white line with slight gradients, resembling a stylized path or route." class="about-approach-layer" /></div><img src="/images/about-diagnose-badge.svg" loading="lazy" data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;27343f8d-fe71-f69e-3b70-f0325b620325&quot;],[]]]" alt="Blue circular badge with a white stylized letter C and inner dot, casting a soft shadow." class="about-approach-layer is-badge" /><img src="/images/about-diagnose-cursor.svg" loading="lazy" data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;2215c379-b2a6-55dd-8cf8-677dc3b56ce9&quot;],[]]]" alt="Small cursor arrow icon with a dark blue fill and white border." class="about-approach-layer is-cursor" />
                    </div>
                  </div>
                  <div class="about-approach-card-content">
                    <h3 class="about-card-title">Diagnose</h3>
                    <p class="about-card-text">We spend the first weeks listening — to leadership, to operators, to customers and to the data — until the real problem is clear.</p>
                  </div>
                </div>
                <div class="about-approach-card is-decide">
                  <div aria-hidden="true" class="about-approach-visual">
                    <div class="about-approach-stage"><img src="/images/about-decide-base.webp" loading="lazy" alt="Blue circular logo with a white stylized letter 'C' and a smaller dot inside, set against a dark to light blue gradient background with subtle overlapping curved shapes." class="about-approach-layer" />
                      <div data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;f83ecbad-c81e-9759-80e9-0d1f1083d37c&quot;],[]]]" class="about-approach-orbit"><img src="/images/about-decide-node-1.svg" loading="lazy" data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;4234c6bc-b5c8-fac2-f1a3-7d6b7c959561&quot;],[]]]" alt="Circular badge with stylized lowercase letters 'uh' in the center, using a modern, bold font." class="about-approach-node is-1" /><img src="/images/about-decide-node-2.svg" loading="lazy" data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;768c7558-c548-f7b1-fed4-eefa0300baed&quot;],[]]]" alt="A circular logo featuring a stylized sparkling star symbol inside a rounded square with a small dot near the upper right corner, all in shades of gray." class="about-approach-node is-2" /><img src="/images/about-decide-node-3.svg" loading="lazy" data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;517e2a64-75d7-b214-b08b-cbaa3546ca3d&quot;],[]]]" alt="Geometric abstract icon featuring a central diamond shape divided by a vertical line, with two smaller adjacent polygonal shapes." class="about-approach-node is-3" /><img src="/images/about-decide-node-4.svg" loading="lazy" data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;12c8d8ac-b039-8adf-28db-8ade75fb59e5&quot;],[]]]" alt="Circular icon resembling a flower with twelve rounded petals arranged evenly around a central point." class="about-approach-node is-4" /><img src="/images/about-decide-node-5.svg" loading="lazy" data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;0e755e19-1da7-e5d2-24dc-faae141e1a2c&quot;],[]]]" alt="Two vertical speech bubble shapes side by side inside a circle, representing a quote symbol." class="about-approach-node is-5" /><img src="/images/about-decide-node-6.svg" loading="lazy" data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;1ce8421c-408f-5031-24e3-e66ab92acf4b&quot;],[]]]" alt="Abstract gray icon centered within a circular shape, featuring angular forms resembling an upward and rightward arrow junction." class="about-approach-node is-6" /></div>
                    </div>
                  </div>
                  <div class="about-approach-card-content">
                    <h3 class="about-card-title">Decide</h3>
                    <p class="about-card-text">We frame the few choices that matter, model the trade-offs and help leadership commit to a direction with confidence.</p>
                  </div>
                </div>
                <div data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;ce985c98-4700-76b8-8900-aab539529114&quot;],[]]]" class="about-approach-card is-deliver">
                  <div aria-hidden="true" class="about-deliver-media">
                    <div class="about-deliver-sheet is-back"></div>
                    <div class="about-deliver-sheet is-mid"></div>
                    <div class="about-deliver-card">
                      <div class="about-deliver-header">
                        <div class="about-deliver-title"><svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" class="about-deliver-icon">
                            <path d="M3.48 3.48V24.39H24.39M8.13 17.42L12.78 12.78L16.26 16.26L22.07 9.29" stroke="currentColor" stroke-width="2.32" stroke-linecap="round" stroke-linejoin="round"></path>
                          </svg>
                          <div>Results Tracker</div>
                        </div>
                        <div class="about-deliver-dropdown">
                          <div>Weekly</div><svg viewBox="-4.5 -7 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" class="about-deliver-icon">
                            <path d="M0.9 0.9L6.32 6.32L11.74 0.9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                          </svg>
                        </div>
                      </div>
                      <div class="about-deliver-body">
                        <div class="about-deliver-gauge">
                          <div data-gauge="1" data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;ad2f4efb-f442-ba41-efdc-614512f0e5c8&quot;],[]]]" class="about-deliver-segment"><svg viewBox="0 0 372 205" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M30.9688 185.811C30.9673 161.2 36.8325 136.942 48.0781 115.051C59.3238 93.1585 75.6258 74.2625 95.6327 59.929C115.64 45.5956 138.775 36.2377 163.121 32.6311C187.466 29.0245 212.321 31.2732 235.624 39.1907" stroke="#1A66FF" stroke-width="34.07" stroke-linecap="round"></path>
                            </svg></div>
                          <div data-gauge="2" data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;9d23e8fd-d9c8-e8da-5217-e58da6423a17&quot;],[]]]" class="about-deliver-segment"><svg viewBox="0 0 372 205" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M245.75 43.0466C277.205 56.2495 303.42 79.4705 320.322 109.103" stroke="#B3CDFF" stroke-width="34.07" stroke-linecap="round"></path>
                            </svg></div>
                          <div data-gauge="3" data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;6e4c190a-5323-89e0-3cf4-28ef8953ff9f&quot;],[]]]" class="about-deliver-segment"><svg viewBox="0 0 372 205" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M325.355 118.687C335.427 139.63 340.656 162.572 340.654 185.811" stroke="#D9E6FF" stroke-width="34.07" stroke-linecap="round"></path>
                            </svg></div>
                          <div data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;251280fb-872d-7245-95f2-73b87856b426&quot;],[]]]" class="about-deliver-gauge-center">
                            <div class="about-deliver-label">Plan delivered</div>
                            <div class="about-deliver-value">80%</div>
                          </div>
                        </div>
                        <div class="about-deliver-divider"></div>
                        <div class="about-deliver-stats">
                          <div data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;1198ea22-aaa5-0918-7d07-27bb1268fa0d&quot;],[]]]" class="about-deliver-stat">
                            <div class="about-deliver-chip"><svg viewBox="0 0 37 37" fill="none" xmlns="http://www.w3.org/2000/svg" class="about-deliver-chip-icon">
                                <path d="M7.74 22.45C7.74 22.45 10.06 22.45 13.16 27.87C13.16 27.87 21.77 13.68 29.42 10.84" stroke="currentColor" stroke-width="2.32" stroke-linecap="round" stroke-linejoin="round"></path>
                              </svg></div>
                            <div class="about-deliver-stat-text">
                              <div class="about-deliver-stat-label">Plan</div>
                              <div class="about-deliver-stat-value">8 of 10</div>
                            </div>
                          </div>
                          <div data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;8d0e62f6-31b7-c2fa-4830-163c44c0bdac&quot;],[]]]" class="about-deliver-stat is-bordered">
                            <div class="about-deliver-chip"><svg viewBox="0 0 37 37" fill="none" xmlns="http://www.w3.org/2000/svg" class="about-deliver-chip-icon">
                                <path d="M18.97 13.55C18.97 16.33 16.72 18.58 13.94 18.58C11.16 18.58 8.9 16.33 8.9 13.55C8.9 10.77 11.16 8.52 13.94 8.52C16.72 8.52 18.97 10.77 18.97 13.55ZM23.98 12.39C25.39 11.5 26.32 9.92 26.32 8.13C26.32 5.35 24.08 3.1 21.31 3.1C19.95 3.1 18.71 3.64 17.81 4.52M4.65 31.74C4.65 26.62 8.81 22.84 13.94 22.84C16.9 22.84 19.5 24.1 21.2 26.1M29.42 24.77V33.29M25.16 29.03H33.68" stroke="currentColor" stroke-width="2.32" stroke-linecap="round" stroke-linejoin="round"></path>
                              </svg></div>
                            <div class="about-deliver-stat-text">
                              <div class="about-deliver-stat-label">Team</div>
                              <div class="about-deliver-stat-value">12 Owners</div>
                            </div>
                          </div>
                          <div data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;89619e43-2d5f-57c2-b822-f73988fca971&quot;],[]]]" class="about-deliver-stat is-bordered">
                            <div class="about-deliver-chip"><svg viewBox="0 0 37 37" fill="none" xmlns="http://www.w3.org/2000/svg" class="about-deliver-chip-icon">
                                <path d="M15.48 6.19H21.68C27.52 6.19 30.44 6.19 32.25 8.01C34.06 9.82 34.06 12.74 34.06 18.58C34.06 24.42 34.06 27.34 32.25 29.15C30.44 30.97 27.52 30.97 21.68 30.97H15.48C9.64 30.97 6.72 30.97 4.91 29.15C3.1 27.34 3.1 24.42 3.1 18.58C3.1 12.74 3.1 9.82 4.91 8.01C6.72 6.19 9.64 6.19 15.48 6.19ZM3.1 21.68H5.97C8.3 21.68 9.46 21.68 10.46 21.16C11.6 20.51 12.25 19.53 13.54 17.56C15.76 14.16 16.88 12.46 18.45 12.39C18.54 12.39 18.62 12.39 18.71 12.39C20.28 12.46 21.4 14.16 23.62 17.56C24.91 19.53 25.56 20.51 26.53 21.07C27.7 21.68 28.86 21.68 31.19 21.68H34.06" stroke="currentColor" stroke-width="2.32" stroke-linecap="round" stroke-linejoin="round"></path>
                              </svg></div>
                            <div class="about-deliver-stat-text">
                              <div class="about-deliver-stat-label">Rhythm</div>
                              <div class="about-deliver-stat-value">Weekly</div>
                            </div>
                          </div>
                        </div>
                        <div data-wf-target="[[[&quot;6ae14c6f29c448b1e5a9fc67&quot;,&quot;310b5b42-27ab-be1d-448a-197018581025&quot;],[]]]" class="about-deliver-note">
                          <div>Results are showing up in the numbers.</div><svg viewBox="0 0 31 31" fill="none" xmlns="http://www.w3.org/2000/svg" class="about-deliver-icon">
                            <path d="M28.4 15.5C28.4 22.62 22.62 28.4 15.5 28.4C8.38 28.4 2.6 22.62 2.6 15.5C2.6 8.38 8.38 2.6 15.5 2.6C22.62 2.6 28.4 8.38 28.4 15.5ZM15.5 14.5V21M15.5 10.4V10.5" stroke="currentColor" stroke-width="1.94" stroke-linecap="round" stroke-linejoin="round"></path>
                          </svg>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="about-approach-deliver-content">
                    <div class="about-approach-deliver-text">
                      <h3 class="heading-style-2 text-color-white">Deliver</h3>
                      <p class="about-card-text">We build the plan with your team, stand up the operating rhythm and stay close until results show up in the numbers.</p>
                    </div>
                    <Button href="/contact-v1">Start a Conversation</Button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
