---
import Button from '../../ui/Button.astro';
---

<section class="section_home-v3-why">
          <div class="section-gap">
            <div class="container-main">
              <div class="home-v3-why-wrapper">
                <div class="section-header">
                  <div class="section-header-title-block">
                    <div class="section-eyebrow">
                      <div class="section-eyebrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                          <path d="M10 0C10.75 6.25 13.75 9.25 20 10C13.75 10.75 10.75 13.75 10 20C9.25 13.75 6.25 10.75 0 10C6.25 9.25 9.25 6.25 10 0Z" fill="currentColor"></path>
                        </svg></div>
                      <div class="section-eyebrow-label">Why Arcline</div>
                    </div>
                    <h2 class="heading-style-2 section-header-heading">Strategy From Insight to Impact</h2>
                    <div class="section-header-doodle is-pos-why w-embed"><svg width="100%" height="100%" viewBox="0 0 45 50" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2 27C3.3557 18.4591 6.90298 10.3881 9 2" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                        <path d="M17.5 32C25.9926 27.1537 34.4984 22.3305 43 17.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                        <path d="M19.8228 47.1832C26.5813 47.234 33.3158 47.9922 40.048 47.9922" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                      </svg></div>
                  </div>
                  <div class="section-header-summary-block">
                    <p class="text-size-regular">Four principles guide every engagement — so recommendations are grounded, owned by your team, and built to last beyond our involvement.</p>
                    <Button href="/contact-v1" variant="dark">Start a Conversation</Button>
                  </div>
                </div>
                <div class="home-v3-why-bento">
                  <div class="home-v3-why-feature">
                    <div class="home-v3-why-feature-content">
                      <div class="home-v3-why-card-text is-large">
                        <div class="home-v3-why-icon"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true" height="100%" width="100%" class="home-v3-why-icon-svg home-v3-why-icon-svg">
                            <path stroke-linejoin="round" stroke-width="1.5" stroke="currentColor" d="M20 4.5L19.5 2L19 4.5L19.5 7L20 4.5Z"></path>
                            <path stroke-linejoin="round" stroke-width="1.5" stroke="currentColor" d="M22 4.5L19.5 4L17 4.5L19.5 5L22 4.5Z"></path>
                            <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M3.25 20.0833V21.4167M4.25 20.75C4.25 21.3023 3.80228 21.75 3.25 21.75C2.69772 21.75 2.25 21.3023 2.25 20.75C2.25 20.1977 2.69772 19.75 3.25 19.75C3.80228 19.75 4.25 20.1977 4.25 20.75Z"></path>
                            <path stroke-width="1.5" stroke="currentColor" d="M12.84 7.64012L12.2249 4.97439C12.0932 4.40403 11.5854 4 11 4C10.4146 4 9.90676 4.40403 9.77514 4.97439L9.15997 7.64012C8.92946 8.63902 8.8142 9.13847 8.56753 9.54755C8.31555 9.96544 7.96544 10.3156 7.54755 10.5675C7.13847 10.8142 6.63902 10.9295 5.64012 11.16L2.97439 11.7751C2.40403 11.9068 2 12.4146 2 13C2 13.5854 2.40403 14.0932 2.97439 14.2249L5.64012 14.84C6.63902 15.0705 7.13847 15.1858 7.54755 15.4325C7.96544 15.6844 8.31555 16.0346 8.56753 16.4524C8.8142 16.8615 8.92946 17.361 9.15997 18.3599L9.77514 21.0256C9.90676 21.596 10.4146 22 11 22C11.5854 22 12.0932 21.596 12.2249 21.0256L12.84 18.3599C13.0705 17.361 13.1858 16.8615 13.4325 16.4524C13.6844 16.0346 14.0346 15.6844 14.4524 15.4325C14.8615 15.1858 15.361 15.0705 16.3599 14.84L19.0256 14.2249C19.596 14.0932 20 13.5854 20 13C20 12.4146 19.596 11.9068 19.0256 11.7751L16.3599 11.16C15.361 10.9295 14.8615 10.8142 14.4524 10.5675C14.0346 10.3156 13.6844 9.96544 13.4325 9.54755C13.1858 9.13847 13.0705 8.63902 12.84 7.64012Z"></path>
                          </svg></div>
                        <div class="home-v3-why-text">
                          <h3 class="heading-style-3">Deep Industry Expertise</h3>
                          <p class="text-size-regular">Familiarize yourself with the business before making solution recommendations.</p>
                        </div>
                      </div>
                      <Button href="/about" variant="dark">Learn More</Button>
                    </div>
                    <div class="home-v3-why-feature-media"><img src="/images/home-v3-why-expertise.webp" loading="lazy" sizes="(max-width: 1366px) 100vw, 1366px" srcset="/images/home-v3-why-expertise-p-500.webp 500w, /images/home-v3-why-expertise-p-800.webp 800w, /images/home-v3-why-expertise-p-1080.webp 1080w, /images/home-v3-why-expertise.webp 1366w" alt="Senior Arcline advisor in glasses smiling in the studio" class="home-v3-why-image" /></div>
                  </div>
                  <div class="home-v3-why-row">
                    <div class="home-v3-why-card">
                      <div class="home-v3-why-card-text">
                        <div class="home-v3-why-icon"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true" height="100%" width="100%" class="home-v3-why-icon-svg home-v3-why-icon-svg">
                            <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M15.5 9L17 18H7L8.5 9"></path>
                            <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M17 22H7C6.53501 22 6.30252 22 6.11177 21.9489C5.59413 21.8102 5.18981 21.4059 5.05111 20.8882C5 20.6975 5 20.465 5 20C5 18.8954 5.89543 18 7 18H17C18.1046 18 19 18.8954 19 20C19 20.465 19 20.6975 18.9489 20.8882C18.8102 21.4059 18.4059 21.8102 17.8882 21.9489C17.6975 22 17.465 22 17 22Z"></path>
                            <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M8.30963 9L7.34359 5.41814C7.2949 5.23761 7.27055 5.14734 7.2617 5.0878C7.14965 4.33422 7.86128 3.7186 8.59808 3.93172C8.6563 3.94856 8.74306 3.98483 8.91659 4.05737C8.99479 4.09006 9.0339 4.1064 9.06942 4.11838C9.49491 4.2618 9.96521 4.12143 10.2404 3.76888C10.2634 3.73944 10.287 3.7044 10.334 3.63432L10.5808 3.26686C11.0609 2.55204 11.301 2.19462 11.6056 2.07419C11.8558 1.97527 12.1347 1.97527 12.3849 2.07419C12.6896 2.19462 12.9296 2.55204 13.4098 3.26686L13.6626 3.64333C13.7181 3.72592 13.7458 3.76722 13.7735 3.80177C14.0398 4.13365 14.4817 4.27287 14.8921 4.15413C14.9348 4.14177 14.9814 4.12391 15.0747 4.08819C15.2819 4.00886 15.3855 3.96919 15.4563 3.95272C16.1721 3.78617 16.8352 4.38044 16.741 5.10415C16.7317 5.17573 16.7025 5.28206 16.6441 5.49472L15.6809 9"></path>
                            <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M7 9C10.9052 9 13.0948 9 17 9"></path>
                          </svg></div>
                        <div class="home-v3-why-text">
                          <h3 class="home-v3-card-title">Human-Centered Strategy</h3>
                          <p class="text-size-regular">People adopt what they help shape — we build with your team, not around it.</p>
                        </div>
                      </div>
                      <div class="home-v3-why-card-media"><img src="/images/home-v3-why-human.webp" loading="lazy" sizes="(max-width: 1216px) 100vw, 1216px" srcset="/images/home-v3-why-human-p-500.webp 500w, /images/home-v3-why-human-p-800.webp 800w, /images/home-v3-why-human-p-1080.webp 1080w, /images/home-v3-why-human.webp 1216w" alt="Consultant leading a discussion with two colleagues" class="home-v3-why-image" /></div>
                    </div>
                    <div class="home-v3-why-card">
                      <div class="home-v3-why-card-text">
                        <div class="home-v3-why-icon"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true" height="100%" width="100%" class="home-v3-why-icon-svg home-v3-why-icon-svg">
                            <path stroke-width="1.5" stroke="currentColor" d="M12 8C16.4183 8 20 6.65685 20 5C20 3.34315 16.4183 2 12 2C7.58172 2 4 3.34315 4 5C4 6.65685 7.58172 8 12 8Z"></path>
                            <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M7 10.8418C7.60158 11.0227 8.27434 11.1716 9 11.2818"></path>
                            <path stroke-width="1.5" stroke="currentColor" d="M20 12C20 13.6569 16.4183 15 12 15C7.58172 15 4 13.6569 4 12"></path>
                            <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M7 17.8418C7.60158 18.0227 8.27434 18.1716 9 18.2818"></path>
                            <path stroke-width="1.5" stroke="currentColor" d="M20 5V19C20 20.6569 16.4183 22 12 22C7.58172 22 4 20.6569 4 19V5"></path>
                          </svg></div>
                        <div class="home-v3-why-text">
                          <h3 class="home-v3-card-title">Data-Led Decisions</h3>
                          <p class="text-size-regular">Every recommendation is grounded in evidence you can trace and defend.</p>
                        </div>
                      </div>
                      <div class="home-v3-why-card-media"><img src="/images/home-v3-why-data.webp" loading="lazy" sizes="(max-width: 1216px) 100vw, 1216px" srcset="/images/home-v3-why-data-p-500.webp 500w, /images/home-v3-why-data-p-800.webp 800w, /images/home-v3-why-data-p-1080.webp 1080w, /images/home-v3-why-data.webp 1216w" alt="Analyst pointing at a performance dashboard on a monitor" class="home-v3-why-image" /></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
