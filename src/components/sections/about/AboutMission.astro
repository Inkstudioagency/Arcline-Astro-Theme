<section class="section_about-mission">
        <div class="section-gap">
          <div class="container-main">
            <div class="about-mission-wrapper">
              <div class="about-mission-header">
                <div class="section-eyebrow is-white">
                  <div class="section-eyebrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                      <path d="M10 0C10.75 6.25 13.75 9.25 20 10C13.75 10.75 10.75 13.75 10 20C9.25 13.75 6.25 10.75 0 10C6.25 9.25 9.25 6.25 10 0Z" fill="currentColor"></path>
                    </svg></div>
                  <div class="section-eyebrow-label is-white">About Arcline</div>
                </div>
                <div class="about-mission-title">
                  <h2 class="heading-style-2 text-color-white">Our Mission</h2>
                  <div class="section-header-doodle is-light is-pos-mission w-embed"><svg width="100%" height="100%" viewBox="0 0 45 50" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                      <path d="M2 27C3.3557 18.4591 6.90298 10.3881 9 2" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                      <path d="M17.5 32C25.9926 27.1537 34.4984 22.3305 43 17.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                      <path d="M19.8228 47.1832C26.5813 47.234 33.3158 47.9922 40.048 47.9922" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                    </svg></div>
                </div>
                <p class="about-mission-summary">To make strategy practical — clear enough to decide on, concrete enough to act on.</p>
              </div>
              <div class="about-mission-cards">
                <div class="about-mission-card">
                  <div class="about-mission-number">01</div>
                  <div class="about-mission-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 48 48" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                      <path d="M30.2624 5C28.2924 4.3511 26.1872 4 24 4C12.9543 4 4 12.9543 4 24C4 35.0456 12.9543 44 24 44C35.0456 44 44 35.0456 44 24C44 21.9096 43.6792 19.8941 43.0844 18" stroke-width="2" stroke-linecap="round" stroke="currentColor"></path>
                      <path d="M34 24C34 29.5228 29.5228 34 24 34C18.4772 34 14 29.5228 14 24C14 18.4772 18.4772 14 24 14" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"></path>
                      <path d="M39 9L24 24M39 9V4M39 9H44" stroke-width="2" stroke-linecap="round" stroke="currentColor"></path>
                    </svg></div>
                  <div class="about-mission-card-text">
                    <h3 class="about-card-title">Clear enough to decide on</h3>
                    <p class="about-card-text">Every option arrives with its trade-offs and numbers, so leadership can choose in one meeting.</p>
                  </div>
                </div>
                <div class="about-mission-card">
                  <div class="about-mission-number">02</div>
                  <div class="about-mission-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 48 48" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
