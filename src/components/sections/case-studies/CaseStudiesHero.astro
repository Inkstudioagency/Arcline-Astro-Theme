---
import CaseStackCard from '../../cards/CaseStackCard.astro';
import { getCaseStudies } from '../../../lib/cms';

const caseStudies = await getCaseStudies();
const list0 = caseStudies.slice(0, 1);
const list1 = caseStudies.slice(1, 2);
const list2 = caseStudies.slice(2, 3);
const list3 = caseStudies.slice(3, 4);
const list4 = caseStudies.slice(4, 5);
---

<section class="section_case-studies-hero"><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" viewBox="0 0 796 796" height="100%" width="100%" class="case-studies-hero-mark case-studies-hero-mark">
          <defs>
            <linearGradient gradientUnits="userSpaceOnUse" y2="775" x2="498" y1="469.5" x1="487.5" id="arcline-cs-mark-fade">
              <stop stop-opacity="0.04" stop-color="currentColor"></stop>
              <stop stop-opacity="0" stop-color="currentColor" offset="1"></stop>
            </linearGradient>
          </defs>
          <path fill="url(#arcline-cs-mark-fade)" d="M320.355 7.64755C397.559 -7.70923 477.583 0.172485 550.308 30.296C623.033 60.4196 685.192 111.432 728.925 176.883C772.658 242.334 796 319.283 796 398H604.96C604.96 357.067 592.822 317.054 570.081 283.02C547.34 248.985 515.017 222.458 477.2 206.794C439.383 191.13 397.77 187.031 357.624 195.017C317.478 203.002 280.601 222.713 251.657 251.657C222.713 280.601 203.002 317.478 195.017 357.624C187.031 397.77 191.13 439.383 206.794 477.2C222.458 515.017 248.985 547.34 283.02 570.081C317.054 592.822 357.067 604.96 398 604.96V796C319.283 796 242.334 772.658 176.883 728.925C111.432 685.192 60.4196 623.033 30.296 550.308C0.172484 477.583 -7.70923 397.559 7.64755 320.355C23.0045 243.15 60.9101 172.233 116.571 116.571C172.233 60.9101 243.15 23.0045 320.355 7.64755ZM625.428 511.714C688.23 511.714 739.143 562.626 739.143 625.429C739.143 688.231 688.23 739.143 625.428 739.143C562.625 739.142 511.714 688.231 511.714 625.429C511.714 562.626 562.625 511.714 625.428 511.714Z"></path>
        </svg>
        <div class="container-main">
          <div class="case-studies-hero-wrapper">
            <div class="case-studies-hero-intro">
              <div class="section-eyebrow is-white"><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" viewBox="0 0 20 20" height="100%" width="100%" class="section-eyebrow-icon section-eyebrow-icon">
                  <path fill="currentColor" d="M10 0C10.75 6.25 13.75 9.25 20 10C13.75 10.75 10.75 13.75 10 20C9.25 13.75 6.25 10.75 0 10C6.25 9.25 9.25 6.25 10 0Z"></path>
                </svg>
                <div class="section-eyebrow-label is-white">Case Studies</div>
              </div>
              <h1 class="case-studies-hero-heading">Work That Creates <span class="heading-accent">Measurable<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" preserveAspectRatio="none" viewBox="0 0 270 18" height="100%" width="100%" class="heading-accent-line is-yellow is-pos-cases-hero heading-accent-line is-wide is-yellow">
                    <path stroke-linecap="round" stroke-width="2" stroke="currentColor" d="M4 9C70 5 160 4 266 7"></path>
                    <path stroke-linecap="round" stroke-width="2" stroke="currentColor" d="M44 15C120 11 200 10 246 12"></path>
                  </svg></span> Impact</h1>
            </div>
            <div class="case-studies-hero-slider">
              <div data-delay="0" data-animation="slide" class="home-cases-slider w-slider" data-autoplay="true" data-easing="ease" data-slider-blur="true" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="1" data-nav-spacing="3" data-duration="500" data-infinite="true">
                <div class="home-cases-slider-mask w-slider-mask">
                  <div class="home-cases-slide w-slide">
                    <div class="w-dyn-list">{list0.length > 0 ? (<div role="list" class="home-cases-list w-dyn-items">{list0.map((item) => (<div role="listitem" class="home-cases-item w-dyn-item"><CaseStackCard item={item} headingTag="h2" imageAlt="media" /></div>))}</div>) : (<div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>)}</div>
                  </div>
                  <div class="home-cases-slide w-slide">
                    <div class="w-dyn-list">{list1.length > 0 ? (<div role="list" class="home-cases-list w-dyn-items">{list1.map((item) => (<div role="listitem" class="home-cases-item w-dyn-item"><CaseStackCard item={item} headingTag="h2" imageAlt="media" /></div>))}</div>) : (<div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>)}</div>
                  </div>
                  <div class="home-cases-slide w-slide">
                    <div class="w-dyn-list">{list2.length > 0 ? (<div role="list" class="home-cases-list w-dyn-items">{list2.map((item) => (<div role="listitem" class="home-cases-item w-dyn-item"><CaseStackCard item={item} headingTag="h2" imageAlt="media" /></div>))}</div>) : (<div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>)}</div>
                  </div>
                  <div class="home-cases-slide w-slide">
                    <div class="w-dyn-list">{list3.length > 0 ? (<div role="list" class="home-cases-list w-dyn-items">{list3.map((item) => (<div role="listitem" class="home-cases-item w-dyn-item"><CaseStackCard item={item} headingTag="h2" imageAlt="media" /></div>))}</div>) : (<div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>)}</div>
                  </div>
                  <div class="home-cases-slide w-slide">
                    <div class="w-dyn-list">{list4.length > 0 ? (<div role="list" class="home-cases-list w-dyn-items">{list4.map((item) => (<div role="listitem" class="home-cases-item w-dyn-item"><CaseStackCard item={item} headingTag="h2" imageAlt="media" /></div>))}</div>) : (<div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>)}</div>
                  </div>
                </div>
                <div class="home-cases-arrow is-left w-slider-arrow-left">
                  <div class="home-cases-arrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                      <path d="M5.5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M11 18C11 18 5 13.58 5 12C5 10.42 11 6 11 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg></div>
                </div>
                <div class="home-cases-arrow is-right w-slider-arrow-right">
                  <div class="home-cases-arrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                      <path d="M18.5 12H5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M13 18C13 18 19 13.58 19 12C19 10.42 13 6 13 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg></div>
                </div>
                <div class="home-cases-slider-nav w-slider-nav w-round w-num"></div>
              </div>
            </div>
          </div>
        </div>
      </section>
