---
import type { BlogPost } from '../../lib/cms';
import { blogUrl, formatDate, mediaAlt, mediaSrc } from '../../lib/cms';
import Button from '../ui/Button.astro';

interface Props {
  item: BlogPost;
}

const { item } = Astro.props;
---

<div class="blog-card is-v3">
                            <a href={blogUrl(item)} class="blog-card-image-wrapper is-v3 w-inline-block"><img src={mediaSrc(item.mainImage)} loading="lazy" alt={mediaAlt(item.mainImage)} class="blog-card-image" />
                              <div class="home-v3-insights-category">
                                <div class="home-v3-insights-dot"></div>
                                <div class="blog-card-meta-text">{item.category}</div>
                              </div>
                            </a>
                            <div class="blog-card-body is-v3">
                              <div class="home-v3-insights-top">
                                <div class="blog-card-meta">
                                  <div class="blog-card-meta-text">{formatDate(item.publishedDate)}</div>
                                  <div class="blog-card-meta-text">·</div>
                                  <div class="blog-card-meta-text">{item.readTime}</div>
                                </div>
                                <a href={blogUrl(item)} class="blog-card-title-block w-inline-block">
                                  <h2 class="blog-card-title">{item.title}</h2>
                                </a>
                              </div>
                              <Button href={blogUrl(item)} variant="secondary">Read More</Button>
                            </div>
                          </div>
