import HomeHero from '../components/sections/home/HomeHero.astro';
import HomeIntro from '../components/sections/home/HomeIntro.astro';
import HomeMetrics from '../components/sections/home/HomeMetrics.astro';
import HomeWhy from '../components/sections/home/HomeWhy.astro';
import HomeServices from '../components/sections/home/HomeServices.astro';
import HomeProcess from '../components/sections/home/HomeProcess.astro';
import HomeCases from '../components/sections/home/HomeCases.astro';
import HomeTestimonials from '../components/sections/home/HomeTestimonials.astro';
