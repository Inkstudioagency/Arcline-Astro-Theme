---
import BlogCardV3 from '../../cards/BlogCardV3.astro';
import { getBlogPosts, whereEquals } from '../../../lib/cms';

const posts = await getBlogPosts();
const list0 = posts.slice(0, 6);
const list1 = whereEquals(posts, 'category', 'Strategy');
const list2 = whereEquals(posts, 'category', 'Finance');
const list3 = whereEquals(posts, 'category', 'Operations');
const list4 = whereEquals(posts, 'category', 'Growth');
---

<section class="section_blog-v3-list">
        <div class="section-gap">
          <div class="container-main">
            <div class="blog-v3-wrapper">
              <div class="section-header">
                <div class="section-header-title-block">
                  <div class="section-eyebrow">
                    <div class="section-eyebrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10 0C10.75 6.25 13.75 9.25 20 10C13.75 10.75 10.75 13.75 10 20C9.25 13.75 6.25 10.75 0 10C6.25 9.25 9.25 6.25 10 0Z" fill="currentColor"></path>
                      </svg></div>
                    <div class="section-eyebrow-label">Blog</div>
                  </div>
                  <h1 class="heading-style-2 section-header-heading">Latest Articles</h1>
                  <div class="section-header-doodle is-pos-latest-v3 w-embed"><svg width="100%" height="100%" viewBox="0 0 45 50" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                      <path d="M2 27C3.3557 18.4591 6.90298 10.3881 9 2" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                      <path d="M17.5 32C25.9926 27.1537 34.4984 22.3305 43 17.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                      <path d="M19.8228 47.1832C26.5813 47.234 33.3158 47.9922 40.048 47.9922" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                    </svg></div>
                </div>
                <div class="section-header-summary-block">
                  <p class="text-size-regular">Search 120+ articles, guides and briefings on strategy, operations, finance and growth.</p>
                </div>
              </div>
              <div data-current="Tab 1" data-easing="ease" data-duration-in="300" data-duration-out="100" class="blog-v2-content w-tabs">
                <div class="blog-v2-filter is-v3 w-tab-menu">
                  <a data-w-tab="Tab 1" class="blog-v2-filter-tab is-active w-inline-block w-tab-link w--current">
                    <div>All</div>
                  </a>
                  <a data-w-tab="Tab 2" class="blog-v2-filter-tab w-inline-block w-tab-link">
                    <div>Strategy</div>
                  </a>
                  <a data-w-tab="Tab 3" class="blog-v2-filter-tab w-inline-block w-tab-link">
                    <div>Finance</div>
                  </a>
                  <a data-w-tab="Tab 4" class="blog-v2-filter-tab w-inline-block w-tab-link">
                    <div>Operations</div>
                  </a>
                  <a data-w-tab="Tab 5" class="blog-v2-filter-tab w-inline-block w-tab-link">
                    <div>Growth</div>
                  </a>
                </div>
                <div class="blog-v2-panels w-tab-content">
                  <div data-w-tab="Tab 1" class="w-tab-pane w--tab-active">
                    <div class="blog-v2-panel w-dyn-list">{list0.length > 0 ? (<div role="list" class="home-insights-list is-blog-v3 w-dyn-items">{list0.map((item) => (<div role="listitem" class="home-insights-item w-dyn-item"><BlogCardV3 item={item} /></div>))}</div>) : (<div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>)}</div>
                  </div>
                  <div data-w-tab="Tab 2" class="w-tab-pane">
                    <div class="blog-v2-panel w-dyn-list">{list1.length > 0 ? (<div role="list" class="home-insights-list is-blog-v3 w-dyn-items">{list1.map((item) => (<div role="listitem" class="home-insights-item w-dyn-item"><BlogCardV3 item={item} /></div>))}</div>) : (<div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>)}</div>
                  </div>
                  <div data-w-tab="Tab 3" class="w-tab-pane">
                    <div class="blog-v2-panel w-dyn-list">{list2.length > 0 ? (<div role="list" class="home-insights-list is-blog-v3 w-dyn-items">{list2.map((item) => (<div role="listitem" class="home-insights-item w-dyn-item"><BlogCardV3 item={item} /></div>))}</div>) : (<div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>)}</div>
                  </div>
                  <div data-w-tab="Tab 4" class="w-tab-pane">
                    <div class="blog-v2-panel w-dyn-list">{list3.length > 0 ? (<div role="list" class="home-insights-list is-blog-v3 w-dyn-items">{list3.map((item) => (<div role="listitem" class="home-insights-item w-dyn-item"><BlogCardV3 item={item} /></div>))}</div>) : (<div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>)}</div>
                  </div>
                  <div data-w-tab="Tab 5" class="w-tab-pane">
                    <div class="blog-v2-panel w-dyn-list">{list4.length > 0 ? (<div role="list" class="home-insights-list is-blog-v3 w-dyn-items">{list4.map((item) => (<div role="listitem" class="home-insights-item w-dyn-item"><BlogCardV3 item={item} /></div>))}</div>) : (<div class="w-dyn-empty">
                        <div>No items found.</div>
                      </div>)}</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
