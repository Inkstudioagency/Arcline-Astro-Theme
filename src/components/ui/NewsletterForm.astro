---
// Footer newsletter form (Webflow form markup). Submissions are sent by src/scripts/forms.ts to PUBLIC_FORM_ENDPOINT;
// the success / error blocks below are shown exactly as Webflow did.
import { site } from '../../config/site';
// Submitted by src/scripts/forms.ts (JSON). The action also lets the form post without JavaScript.
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
const formAction = formEndpoint || '#';
const formMethod = formEndpoint ? 'post' : 'get';
---

<div class="footer-form-block w-form">
  <form id="wf-form-Newsletter-Form" name="wf-form-Newsletter-Form" data-name="Newsletter Form" action={formAction} method={formMethod} class="footer-form">
    <input
      class="footer-input w-input"
      maxlength="256"
      name="Newsletter-Email"
      data-name="Newsletter Email"
      aria-label="Newsletter Email"
      placeholder="Your work email"
      type="email"
      id="footer-email"
      required
    /><input type="submit" data-wait="Please wait..." class="footer-form-button w-button" value="Subscribe" />
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-honeypot" />
  </form>
  <div class="footer-form-message w-form-done" role="status">
    <div>{site.newsletter.success}</div>
  </div>
  <div class="footer-form-message w-form-fail" role="alert">
    <div>{site.newsletter.error}</div>
  </div>
</div>
