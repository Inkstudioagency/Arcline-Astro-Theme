---
import Button from '../../ui/Button.astro';
---

<section class="section_home-v2-hero">
        <div class="home-v2-hero-mark w-embed"><svg width="100%" height="100%" viewBox="0 0 796 796" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="arcline-v2-mark-fade" x1="487.5" y1="469.5" x2="498" y2="775" gradientUnits="userSpaceOnUse">
                <stop stop-color="currentColor" stop-opacity="0.04"></stop>
                <stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <path d="M320.355 7.64755C397.559 -7.70923 477.583 0.172485 550.308 30.296C623.033 60.4196 685.192 111.432 728.925 176.883C772.658 242.334 796 319.283 796 398H604.96C604.96 357.067 592.822 317.054 570.081 283.02C547.34 248.985 515.017 222.458 477.2 206.794C439.383 191.13 397.77 187.031 357.624 195.017C317.478 203.002 280.601 222.713 251.657 251.657C222.713 280.601 203.002 317.478 195.017 357.624C187.031 397.77 191.13 439.383 206.794 477.2C222.458 515.017 248.985 547.34 283.02 570.081C317.054 592.822 357.067 604.96 398 604.96V796C319.283 796 242.334 772.658 176.883 728.925C111.432 685.192 60.4196 623.033 30.296 550.308C0.172484 477.583 -7.70923 397.559 7.64755 320.355C23.0045 243.15 60.9101 172.233 116.571 116.571C172.233 60.9101 243.15 23.0045 320.355 7.64755ZM625.428 511.714C688.23 511.714 739.143 562.626 739.143 625.429C739.143 688.231 688.23 739.143 625.428 739.143C562.625 739.142 511.714 688.231 511.714 625.429C511.714 562.626 562.625 511.714 625.428 511.714Z" fill="url(#arcline-v2-mark-fade)"></path>
          </svg></div>
        <div class="container-main">
          <div class="home-v2-hero-wrapper">
            <div class="home-v2-hero-content">
              <div class="home-hero-eyebrow">
                <div class="home-hero-eyebrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 3C7 7 8 9 14 10C8 11 7 13 7 17C7 13 6 11 0 10C6 9 7 7 7 3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
                    <path d="M16 0C16 2 16.5 3.5 20 4C16.5 4.5 16 6 16 8C16 6 15.5 4.5 12 4C15.5 3.5 16 2 16 0Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"></path>
                  </svg></div>
                <div class="home-hero-eyebrow-label">Strategy • Growth • Transformation</div>
              </div>
              <h1 class="home-hero-heading">Turn <span class="heading-accent">Complexity<div class="heading-accent-line is-yellow is-pos-v2-hero w-embed"><svg width="100%" height="100%" viewBox="0 0 270 18" preserveAspectRatio="none" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                      <path d="M4 9C70 5 160 4 266 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
                      <path d="M44 15C120 11 200 10 246 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
                    </svg></div></span> Into Clear Growth</h1>
              <div class="button-row is-hero">
                <Button href="/contact-v1">Start a Conversation</Button>
                <Button href="/services" variant="outline">Explore Services</Button>
              </div>
            </div>
            <div class="home-v2-hero-visual">
              <div class="home-v2-hero-layer is-back"></div>
              <div class="home-v2-hero-layer"></div><img src="/images/home-v2-hero-photo.webp" loading="lazy" sizes="(max-width: 2720px) 100vw, 2720px" srcset="/images/home-v2-hero-photo-p-500.webp 500w, /images/home-v2-hero-photo-p-800.webp 800w, /images/home-v2-hero-photo-p-1080.webp 1080w, /images/home-v2-hero-photo-p-1600.webp 1600w, /images/home-v2-hero-photo-p-2000.webp 2000w, /images/home-v2-hero-photo-p-2600.webp 2600w, /images/home-v2-hero-photo.webp 2720w" alt="Smiling client checking a phone, with engagement and growth trend cards" class="home-v2-hero-image" />
              <div data-wf-target="[[[&quot;6ae033d0878c45bf0bacd9c7&quot;,&quot;f53ef570-15d3-89cb-949c-6cc587b9d0eb&quot;],[]]]" class="home-v2-hero-card is-snapshot"><img src="/images/home-v2-hero-card-snapshot.svg" loading="lazy" data-wf-target="[[[&quot;6ae033d0878c45bf0bacd9c7&quot;,&quot;30a212f4-2ecc-b24a-92e2-e85c8e5b20bd&quot;],[]]]" alt="Engagement snapshot card showing client activity" class="home-v2-hero-card-image" /></div><img src="/images/home-v2-hero-hand.webp" loading="lazy" alt="Smiling woman with red hair wearing a purple knit sweater, holding and looking at a green smartphone." class="home-v2-hero-cutout" />
              <div data-wf-target="[[[&quot;6ae033d0878c45bf0bacd9c7&quot;,&quot;5f0c74a6-d65d-667d-bf8e-9903d9a62987&quot;],[]]]" class="home-v2-hero-card is-trend"><img src="/images/home-v2-hero-card-trend.svg" loading="lazy" data-wf-target="[[[&quot;6ae033d0878c45bf0bacd9c7&quot;,&quot;628552ae-05d4-5f4a-eb08-f95fa4ba7916&quot;],[]]]" alt="Engagement trend chart card showing growth" class="home-v2-hero-card-image" /></div>
            </div>
          </div>
          <div class="home-metrics-logos is-v2">
            <div class="home-metrics-logos-label is-v2">Trusted by 100+ companies worldwide</div>
            <div class="home-metrics-logos-track">
              <div class="home-metrics-logos-list"><img src="/images/home-logo-monosen.svg" loading="lazy" alt="Monosen logo" class="home-metrics-logo is-v2" /><img src="/images/home-logo-overcut.svg" loading="lazy" alt="Overcut logo" class="home-metrics-logo is-v2" /><img src="/images/home-logo-primex.svg" loading="lazy" alt="Primex logo" class="home-metrics-logo is-v2" /><img src="/images/home-logo-boomers.svg" loading="lazy" alt="Boomers logo" class="home-metrics-logo is-v2" /><img src="/images/home-logo-reverse.svg" loading="lazy" alt="Reverse logo" class="home-metrics-logo is-v2" /><img src="/images/home-logo-unicell.svg" loading="lazy" alt="Unicell logo" class="home-metrics-logo is-v2" /><img src="/images/home-logo-walter.svg" loading="lazy" alt="Walter logo" class="home-metrics-logo is-v2" /></div>
            </div>
          </div>
        </div>
      </section>
