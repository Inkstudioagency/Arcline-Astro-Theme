---
import type { CaseStudy } from '../../../lib/cms';
import { mediaSrc } from '../../../lib/cms';

interface Props {
  item: CaseStudy;
}

const { item } = Astro.props;
---

<section class="section_case-details-quote">
        <div class="section-gap">
          <div class="container-main">
            <figure class="blog-details-quote-wrapper">
              <div class="blog-details-quote-mark w-embed"><svg width="100%" height="100%" viewBox="0 0 244 193.91" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0 193.91L56.1617 0H113.462L81.9658 193.91H0ZM130.538 193.91L186.7 0H244L212.504 193.91H130.538Z" fill="url(#arcline-case-quote-fade)"></path>
                  <defs>
                    <linearGradient id="arcline-case-quote-fade" x1="122" y1="0" x2="122" y2="193.91" gradientUnits="userSpaceOnUse">
                      <stop stop-color="currentColor" stop-opacity="0.12"></stop>
                      <stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
                    </linearGradient>
                  </defs>
                </svg></div>
              <blockquote class="blog-details-quote-text">{item.quote?.text}</blockquote>
              <figcaption class="blog-details-quote-author blog-details-quote-author"><img src={mediaSrc(item.quote?.authorPhoto)} loading="lazy" alt={item.quote?.authorName} class="blog-details-quote-avatar" />
                <div class="blog-details-quote-person">
                  <div class="blog-details-quote-name">{item.quote?.authorName}</div>
                  <div class="blog-details-quote-role">{item.quote?.authorRole}</div>
                </div>
              </figcaption>
            </figure>
          </div>
        </div>
      </section>
