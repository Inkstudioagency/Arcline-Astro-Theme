                    <h3 class="about-card-title is-wide">Could your team run it on Monday?</h3>
                    <p class="about-card-text">Every recommendation we make has to pass one test.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
