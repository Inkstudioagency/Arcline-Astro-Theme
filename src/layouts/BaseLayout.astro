---
import '../styles/normalize.css';
import '../styles/webflow.css';
import '../styles/arcline.webflow.css';
import '../styles/custom.css';
import ix3InitialStates from '../styles/ix3-initial-states.css?raw';
import SEO from '../components/global/SEO.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Header style: `hero-fixed` = transparent header over a full-bleed hero (Home V1, Home V3). */
  header?: 'base' | 'hero-fixed';
  /**
   * Webflow page id. The interaction runtime (public/js/webflow.js) looks up each page's IX3 animations by this id,
   * so every page keeps the id of the template page it came from.
   */
  wfPage: string;
}

const { wfPage, header = 'base', ...seo } = Astro.props;
---

<!doctype html>
<html data-wf-page={wfPage} lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...seo} />
    {/* Initial (hidden) states for the IX3 animations; released once the runtime adds .w-mod-ix3 */}
    <style is:inline set:html={ix3InitialStates}></style>
    <script is:inline>
      !(function (o, c) {
        var n = c.documentElement,
          t = ' w-mod-';
        (n.className += t + 'js'),
          ('ontouchstart' in o || (o.DocumentTouch && c instanceof DocumentTouch)) && (n.className += t + 'touch');
      })(window, document);
    </script>
    <link href="/images/favicon.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link href="/images/favicon-48.png" rel="icon" type="image/png" sizes="48x48" />
    <link href="/images/webclip-180.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/images/webclip-192.png" rel="icon" type="image/png" sizes="192x192" />
    <link href="/images/webclip.png" rel="icon" type="image/png" sizes="512x512" />
    <link rel="stylesheet" href="/js/lenis.css" />
    <script is:inline src="/js/lenis.min.js"></script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="page-wrapper">
      <Header variant={header} />
      <main id="main" tabindex="-1" class="main-wrapper">
        <slot />
      </main>
      <Footer />
    </div>
    {/* Interaction runtime (dropdowns, tabs, sliders, background video, lottie, IX3 animations) — same order as the template */}
    <script is:inline src="/js/jquery-3.5.1.min.js"></script>
    <script is:inline src="/js/webflow.js"></script>
    <script is:inline src="/js/gsap.min.js"></script>
    <script is:inline src="/js/SplitText.min.js"></script>
    <script is:inline src="/js/ScrollTrigger.min.js"></script>
    <script is:inline>
      gsap.registerPlugin(SplitText, ScrollTrigger);
    </script>
    <script>
      import '../scripts/site.js';
      import '../scripts/forms';
    </script>
  </body>
</html>
