---
import Button from '../../ui/Button.astro';
---

<section class="section_about-stats">
        <div class="section-gap">
          <div class="container-main">
            <div class="about-stats-wrapper">
              <div class="about-stats-header">
                <div class="section-eyebrow">
                  <div class="section-eyebrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                      <path d="M10 0C10.75 6.25 13.75 9.25 20 10C13.75 10.75 10.75 13.75 10 20C9.25 13.75 6.25 10.75 0 10C6.25 9.25 9.25 6.25 10 0Z" fill="currentColor"></path>
                    </svg></div>
                  <div class="section-eyebrow-label">Arcline, By The Numbers</div>
                </div>
                <div class="about-stats-heading-block">
                  <h2 class="about-stats-heading">Senior Advisors Who Stay Until The Results Show Up In The Numbers</h2><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" preserveAspectRatio="none" viewBox="0 0 270 18" width="100%" height="100%" class="heading-accent-line is-pos-stats">
                    <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M4 9C70 5 160 4 266 7"></path>
                    <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M44 15C120 11 200 10 246 12"></path>
                  </svg>
                </div>
              </div>
              <div class="about-stats-media"><img src="/images/about-stats-team.webp" loading="lazy" sizes="100vw" srcset="/images/about-stats-team-p-500.webp 500w, /images/about-stats-team-p-800.webp 800w, /images/about-stats-team-p-1080.webp 1080w, /images/about-stats-team.webp 1220w" alt="Two Arcline consultants smiling while reviewing results on their phones" class="about-stats-image" />
                <div class="about-stats-caption">
                  <p class="about-stats-text">120+ engagements delivered across strategy, finance and operations</p>
                </div>
              </div>
              <div class="about-stats-bottom">
                <div class="about-stats-intro">
                  <p class="about-stats-text">Our partners have run operations, closed books and launched products — so every engagement is led by people who have done the work, not just advised on it.</p>
                  <Button href="/contact-v1" variant="dark">Start a Conversation</Button>
                </div>
                <div class="about-stats-list">
                  <div class="about-stats-item">
                    <div data-counter="counter" class="about-stats-number">35+</div>
                    <p class="about-stats-text">Industries Supported</p>
                  </div>
                  <div class="about-stats-item">
                    <div data-counter="counter" class="about-stats-number">92%</div>
                    <p class="about-stats-text">Client Retention</p>
                  </div>
                  <div class="about-stats-item">
                    <div data-counter="counter" class="about-stats-number">18+</div>
                    <p class="about-stats-text">Years Combined Expertise</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
