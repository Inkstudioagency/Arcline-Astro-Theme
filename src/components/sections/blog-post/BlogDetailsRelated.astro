---
import LinkButton from '../../ui/LinkButton.astro';
import BlogRelatedCard from '../../cards/BlogRelatedCard.astro';
import { getBlogPosts } from '../../../lib/cms';

const posts = await getBlogPosts();
const list0 = posts.slice(0, 3);
---

<section class="section_blog-details-related">
        <div class="section-gap">
          <div class="container-main">
            <div class="home-insights-wrapper">
              <div class="section-header">
                <div class="section-header-title-block">
                  <div class="section-eyebrow">
                    <div class="section-eyebrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10 0C10.75 6.25 13.75 9.25 20 10C13.75 10.75 10.75 13.75 10 20C9.25 13.75 6.25 10.75 0 10C6.25 9.25 9.25 6.25 10 0Z" fill="currentColor"></path>
                      </svg></div>
                    <div class="section-eyebrow-label">Keep reading</div>
                  </div>
                  <h2 class="heading-style-2 section-header-heading">More Insights</h2>
                  <div class="section-header-doodle is-pos-insights-more w-embed"><svg width="100%" height="100%" viewBox="0 0 45 50" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                      <path d="M2 27C3.3557 18.4591 6.90298 10.3881 9 2" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                      <path d="M17.5 32C25.9926 27.1537 34.4984 22.3305 43 17.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                      <path d="M19.8228 47.1832C26.5813 47.234 33.3158 47.9922 40.048 47.9922" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                    </svg></div>
                </div>
                <div class="section-header-summary-block home-insights-action">
                  <LinkButton href="/blog-v1">All insights</LinkButton>
                </div>
              </div>
              <div class="home-insights-list-wrapper w-dyn-list">{list0.length > 0 ? (<div role="list" class="home-insights-list w-dyn-items">{list0.map((item) => (<div role="listitem" class="home-insights-item w-dyn-item"><BlogRelatedCard item={item} /></div>))}</div>) : (<div class="w-dyn-empty">
                  <div>No items found.</div>
                </div>)}</div>
            </div>
          </div>
        </div>
      </section>
