---

---

<section class="section_home-metrics">
          <div class="home-metrics-card">
            <div class="container-main">
              <div class="home-metrics-wrapper">
                <div class="home-metrics-grid">
                  <div class="home-metrics-header">
                    <div class="section-eyebrow is-white">
                      <div class="section-eyebrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                          <path d="M10 0C10.75 6.25 13.75 9.25 20 10C13.75 10.75 10.75 13.75 10 20C9.25 13.75 6.25 10.75 0 10C6.25 9.25 9.25 6.25 10 0Z" fill="currentColor"></path>
                        </svg></div>
                      <div class="section-eyebrow-label is-white">Who We Are</div>
                    </div>
                    <div class="home-metrics-title-block">
                      <h2 class="heading-style-2 text-color-white">Numbers showing lasting <span class="heading-accent">partnerships.<div class="heading-accent-line is-yellow is-pos-metrics w-embed"><svg width="100%" height="100%" viewBox="0 0 374.43 22.06" preserveAspectRatio="none" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                              <path d="M61.3291 19.2697C139.222 17.1676 217.194 15.3976 294.984 12.5373C297.818 12.4332 307.69 12.2554 313.096 11.6614" stroke="currentColor" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
                              <path d="M1.67145 17.0262C52.2279 12.6815 103.204 11.4038 153.886 9.47906C219.23 6.99745 284.587 4.54069 349.983 3.71966C357.102 3.63027 378.428 3.12863 371.317 2.73955" stroke="currentColor" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
                            </svg></div></span></h2>
                      <p class="text-size-regular text-color-white">Figures shown are illustrative.</p>
                    </div>
                  </div>
                  <div class="home-metrics-stats">
                    <div class="home-metrics-stat">
                      <div class="home-metrics-bar"></div>
                      <div class="home-metrics-stat-text">
                        <div data-counter="counter" class="home-metrics-value">120+</div>
                        <div class="home-metrics-label">Projects Delivered</div>
                      </div>
                    </div>
                    <div class="home-metrics-stat">
                      <div class="home-metrics-bar is-medium"></div>
                      <div class="home-metrics-stat-text">
                        <div data-counter="counter" class="home-metrics-value">92%</div>
                        <div class="home-metrics-label">Client Retention</div>
                      </div>
                    </div>
                    <div class="home-metrics-stat">
                      <div class="home-metrics-bar is-large"></div>
                      <div class="home-metrics-stat-text">
                        <div data-counter="counter" class="home-metrics-value">35+</div>
                        <div class="home-metrics-label">Industries Supported</div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="home-metrics-logos">
                  <div class="home-metrics-logos-label">Trusted by 100+ companies worldwide</div>
                  <div class="home-metrics-logos-track">
                    <div class="home-metrics-logos-list"><img src="/images/home-logo-monosen.svg" loading="lazy" alt="Monosen logo" class="home-metrics-logo" /><img src="/images/home-logo-overcut.svg" loading="lazy" alt="Overcut logo" class="home-metrics-logo" /><img src="/images/home-logo-primex.svg" loading="lazy" alt="Primex logo" class="home-metrics-logo" /><img src="/images/home-logo-boomers.svg" loading="lazy" alt="Boomers logo" class="home-metrics-logo" /><img src="/images/home-logo-reverse.svg" loading="lazy" alt="Reverse logo" class="home-metrics-logo" /><img src="/images/home-logo-unicell.svg" loading="lazy" alt="Unicell logo" class="home-metrics-logo" /><img src="/images/home-logo-walter.svg" loading="lazy" alt="Walter logo" class="home-metrics-logo" /></div>
                    <div aria-hidden="true" class="home-metrics-logos-list"><img src="/images/home-logo-monosen.svg" loading="lazy" alt="" class="home-metrics-logo" /><img src="/images/home-logo-overcut.svg" loading="lazy" alt="" class="home-metrics-logo" /><img src="/images/home-logo-primex.svg" loading="lazy" alt="" class="home-metrics-logo" /><img src="/images/home-logo-boomers.svg" loading="lazy" alt="" class="home-metrics-logo" /><img src="/images/home-logo-reverse.svg" loading="lazy" alt="" class="home-metrics-logo" /><img src="/images/home-logo-unicell.svg" loading="lazy" alt="" class="home-metrics-logo" /><img src="/images/home-logo-walter.svg" loading="lazy" alt="" class="home-metrics-logo" /></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
