---
import type { CaseStudy } from '../../lib/cms';
import { caseStudyUrl, mediaAlt, mediaSrc, pad2 } from '../../lib/cms';
import Button from '../ui/Button.astro';

interface Props {
  item: CaseStudy;
}

const { item } = Astro.props;
---

<div class="case-studies-card">
                              <a href={caseStudyUrl(item)} class="case-studies-card-image-link w-inline-block"><img src={mediaSrc(item.mainImage)} loading="lazy" alt={mediaAlt(item.mainImage)} class="home-cases-card-image" />
                                <div class="home-cases-card-note">
                                  <div class="home-cases-card-note-label">{item.resultLabel}</div>
                                  <div class="home-cases-card-note-row">
                                    <div class="home-cases-card-note-value-group">
                                      <div class="home-cases-card-note-value">{item.resultValue}</div>
                                      <div class="home-cases-card-trend"><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" viewBox="0 0 8 8" height="100%" width="100%" class="home-cases-card-trend-icon home-cases-card-trend-icon">
                                          <path stroke-linejoin="round" stroke-linecap="round" stroke-width="0.67" stroke="currentColor" d="M5.67 5.67V2.33H2.33M5.67 2.33L2.33 5.67"></path>
                                        </svg>
                                        <div class="home-cases-card-trend-text">{item.resultChange}</div>
                                      </div>
                                    </div><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" viewBox="0 0 58 33" height="100%" width="100%" class="home-cases-card-chart home-cases-card-chart">
                                      <path stroke-linecap="round" stroke-opacity="0.6" stroke-width="2" stroke="currentColor" d="M1 32L15 21H35L42 9.5L57 1"></path>
                                    </svg>
                                  </div>
                                </div>
                              </a>
                              <div class="case-studies-card-content">
                                <div class="home-cases-card-top">
                                  <div class="home-cases-card-meta">
                                    <div class="home-cases-card-number">{pad2(item.caseNumber)}</div>
                                    <div class="home-cases-card-dot">•</div>
                                    <div class="home-cases-card-industry">{item.industry}</div>
                                  </div>
                                  <a href={caseStudyUrl(item)} class="case-studies-card-title-link w-inline-block">
                                    <h3 class="home-cases-card-title">{item.title}</h3>
                                  </a>
                                </div>
                                <Button href={caseStudyUrl(item)} variant="secondary">View Case Study</Button>
                              </div>
                            </div>
