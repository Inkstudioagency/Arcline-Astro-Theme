---
import Button from '../../ui/Button.astro';
---

<section class="section_home-v2-intro">
        <div class="container-main">
          <div class="home-v2-intro-wrapper">
            <div class="home-v2-intro-heading-block">
              <div class="section-eyebrow">
                <div class="section-eyebrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 0C10.75 6.25 13.75 9.25 20 10C13.75 10.75 10.75 13.75 10 20C9.25 13.75 6.25 10.75 0 10C6.25 9.25 9.25 6.25 10 0Z" fill="currentColor"></path>
                  </svg></div>
                <div class="section-eyebrow-label">Who We Are</div>
              </div>
              <h2 class="home-intro-heading is-left">Clarity for <span class="home-intro-pill-holder"><img src="/images/home-intro-pill.svg" loading="lazy" alt="" class="home-intro-pill" /></span> Businesses Navigating <span class="heading-accent">Growth.<div class="heading-accent-line is-blue is-pos-intro w-embed"><svg width="100%" height="100%" viewBox="0 0 254.63 22.06" preserveAspectRatio="none" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                      <path d="M41.7072 19.2697C94.6786 17.1676 147.704 15.3976 200.606 12.5373C202.533 12.4332 209.247 12.2554 212.923 11.6614" stroke="currentColor" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
                      <path d="M1.13668 17.0262C35.5179 12.6815 70.1846 11.4038 104.651 9.47906C149.089 6.99745 193.535 4.54069 238.008 3.71966C242.849 3.63027 257.352 3.12863 252.516 2.73955" stroke="currentColor" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
                    </svg></div></span></h2>
            </div>
            <div class="home-v2-intro-row">
              <div class="home-v2-intro-proof">
                <div class="home-intro-avatars is-left"><img src="/images/home-intro-avatar-1.webp" loading="lazy" alt="" class="home-intro-avatar" /><img src="/images/home-intro-avatar-2.webp" loading="lazy" alt="" class="home-intro-avatar" /><img src="/images/home-intro-avatar-3.webp" loading="lazy" alt="" class="home-intro-avatar" /><img src="/images/home-intro-avatar-4.webp" loading="lazy" alt="" class="home-intro-avatar" />
                  <div class="home-intro-avatar-more">
                    <div class="home-intro-avatar-more-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 4V12M12 12V20M12 12H20M12 12H4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg></div>
                  </div>
                </div>
                <p class="home-v2-intro-kicker">Independent advisory for growth-stage and mid-market organizations</p>
              </div>
              <div class="home-v2-intro-content">
                <div class="home-v2-intro-text">
                  <div class="home-intro-proof-row">
                    <div class="section-eyebrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10 0C10.75 6.25 13.75 9.25 20 10C13.75 10.75 10.75 13.75 10 20C9.25 13.75 6.25 10.75 0 10C6.25 9.25 9.25 6.25 10 0Z" fill="currentColor"></path>
                      </svg></div>
                    <div class="home-intro-proof-label">35+ industries — from first diagnostic</div>
                  </div>
                  <p class="text-size-regular">Our founders had spent years inside growing companies — running operations, closing books, launching products. They had seen brilliant strategies stall in the gap between the boardroom and the business.</p>
                </div>
                <Button href="/about" variant="dark">More About Us</Button>
              </div>
            </div>
            <div class="home-v2-intro-stats">
              <div class="home-v2-intro-stat">
                <div class="home-v2-intro-stat-label">Projects delivered</div>
                <div data-counter="counter" class="home-v2-intro-stat-value">120+</div>
              </div><img src="/images/home-v2-intro-visual-chat.webp" loading="lazy" sizes="(max-width: 519px) 100vw, 519px" srcset="/images/home-v2-intro-visual-chat-p-500.webp 500w, /images/home-v2-intro-visual-chat.webp 519w" alt="Client message card from Kathryn Murphy asking for help with her business" class="home-v2-intro-visual" />
              <div class="home-v2-intro-stat">
                <div class="home-v2-intro-stat-label">Client retention</div>
                <div data-counter="counter" class="home-v2-intro-stat-value">92%</div>
              </div><img src="/images/home-v2-intro-visual-team.webp" loading="lazy" sizes="(max-width: 519px) 100vw, 519px" srcset="/images/home-v2-intro-visual-team-p-500.webp 500w, /images/home-v2-intro-visual-team.webp 519w" alt="Our team card showing Arcline advisor avatars" class="home-v2-intro-visual" />
              <div class="home-v2-intro-stat">
                <div class="home-v2-intro-stat-label">Industries supported</div>
                <div data-counter="counter" class="home-v2-intro-stat-value">35+</div>
              </div>
            </div>
          </div>
        </div>
      </section>
